---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";

const schema = {"@context":"https://schema.org","@graph":[{"@type":"Article","headline":"Zhangjiajie National Park Tickets — Prices, Booking & Tips (2026)","description":"Complete guide to Zhangjiajie National Park entrance fees: all ticket types, 2026 prices verified April 2026, where to buy, combo deals, student discounts, and money-saving tips.","datePublished":"2026-07-01","dateModified":"2026-08-05","author":{"@type":"Person","name":"Zhangjiajie Guide Team"}},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://zhangjiajie-national-park.com/"},{"@type":"ListItem","position":2,"name":"Tickets & Prices","item":"https://zhangjiajie-national-park.com/tickets/"}]}]};

const parkTable = [
  { ticket: "Adult (peak: Mar–Nov)", peak: "¥225", offpeak: "¥115", note: "4-day pass, includes shuttles" },
  { ticket: "Adult (off-peak: Dec–Feb)", peak: "—", offpeak: "¥115", note: "Same 4-day pass, half the price" },
  { ticket: "Student (with valid ID)", peak: "¥115", offpeak: "¥58", note: "50% off · Undergraduate & below" },
  { ticket: "Senior (60–69)", peak: "¥115", offpeak: "¥58", note: "50% off · Passport required" },
  { ticket: "Senior (70+)", peak: "Free", offpeak: "Free", note: "Passport verification at gate" },
  { ticket: "Child under 1.2m", peak: "Free", offpeak: "Free", note: "Height measured at entrance" },
  { ticket: "Disabled visitor", peak: "Free", offpeak: "Free", note: "Disability certificate required" },
  { ticket: "Military personnel", peak: "Free", offpeak: "Free", note: "Active duty · Military ID required" },
];

const inParkTransport = [
  { item: "Bailong Elevator (one way)", price: 72, note: "World's tallest outdoor lift · 326m · 2 min ride" },
  { item: "Bailong Elevator (round trip)", price: 144, note: "Same as 2× one-way · No discount for round trip" },
  { item: "Tianzi Mountain Cable Car (one way)", price: 72, note: "1,200m ascent · Sea of clouds on clear mornings" },
  { item: "Yangjiajie Cable Car (one way)", price: 76, note: "Less crowded route · Best for hikers" },
  { item: "Huangshizhai Cable Car (one way)", price: 65, note: "Access to Huangshi Village summit" },
  { item: "Mini-train · Ten-mile Gallery (one way)", price: 38, note: "5.6 km · Walkable in 90 min if you skip the train" },
  { item: "Tianmen Mountain Escalator (inside mountain)", price: 32, note: "Bypasses the 999 steps to Heaven's Gate" },
];

const otherTickets = [
  {
    name: "Tianmen Mountain",
    price: "¥261 (peak: Mar–Nov) / ¥225 (off-peak: Dec–Feb)",
    includes: "Cable car ride (world's longest: 7.5 km) + mountain entry. The cable car alone is worth the ticket.",
    hours: "8:00 AM – 5:30 PM (last entry 4:00 PM)",
    note: "Separate from Forest Park ticket. Cable car starts from downtown Zhangjiajie, not from Wulingyuan.",
    tips: [
      "Book the morning slot (8:00-9:00 AM) — the cable car queue builds fast after 10 AM",
      "Students get 50% off (¥130 peak / ¥113 off-peak)",
      "Combine with the Forest Park: do Tianmen on Day 1 (cable car from city), then move to Wulingyuan for Days 2-3",
    ]
  },
  {
    name: "Grand Canyon + Glass Bridge",
    price: "¥128 (bridge only) / ¥219 (bridge + canyon hike + boat ride)",
    includes: "Glass Bridge crossing + optional canyon hike + exit boat. The full combo is significantly better value.",
    hours: "8:00 AM – 5:00 PM. Time slots: 8:00, 9:00, 10:00, 11:00, 12:30, 13:30, 14:30.",
    note: "Must book a specific time slot online (at least 1 day ahead). Walk-up tickets rarely available.",
    tips: [
      "Get the 8:00 AM slot — half the crowd, twice the experience",
      "The CNY 219 combo (bridge + hike + boat) is the right choice for most visitors",
      "Add CNY 30 for the canyon slide — saves 1,000 steps downhill and is genuinely fun",
      "Bungee jump (¥2,998) and zipline (¥168) are available at the bridge, book separately on-site",
    ]
  },
  {
    name: "Fenghuang Ancient Town",
    price: "¥128 (town entry) · Optional boat ride: ¥60",
    includes: "Town access + major attractions. The entry fee was introduced in 2016; before that it was free.",
    hours: "Open all day. Ticket booths close at 6 PM. Best visited in the late afternoon through evening when the lanterns light up.",
    note: "3-4 hours from Zhangjiajie by bus (¥80). Many visitors go as a day trip or overnight.",
    tips: [
      "If you arrive after 6 PM, some ticket checkpoints are unmanned — but this is unofficial and not guaranteed",
      "The boat ride at dusk with lanterns reflecting on the river is worth the ¥60",
      "Overnight stay (¥100-300) lets you see the town lit up at night with far fewer day-trippers",
    ]
  },
];

const buyOptions = [
  {
    method: "At the Gate (Recommended)",
    pros: "Face-value pricing · No markup · Immediate · Works with cash",
    cons: "Queues 9-11 AM (up to 30 min in peak season) · No foreign credit cards accepted at ticket machines",
    tip: "Arrive by 7:15 AM and you are through in 5 minutes. Ticket booths open at 7:00 AM.",
  },
  {
    method: "Klook / Trip.com",
    pros: "Pay with international card · English interface · Dedicated 'online ticket' window (shorter queue)",
    cons: "5-15% markup (we paid ¥248 for a ¥225 ticket on Klook in April 2026) · Must print or show QR code on phone",
    tip: "Good option if you want peace of mind before arrival. The ¥23 markup is worth the shorter queue on busy mornings.",
  },
  {
    method: "Hotel Concierge",
    pros: "Face-value pricing · No queue · They handle everything · Often available at check-in",
    cons: "Only available if staying in Wulingyuan · Not all hotels offer this · Cash payment to hotel",
    tip: "Ask at check-in. Most mid-range and above hotels in Wulingyuan offer ticket service. Our go-to method.",
  },
  {
    method: "Chinese Apps (WeChat / Alipay)",
    pros: "Face-value pricing · Instant · Book time slots for Glass Bridge",
    cons: "Chinese-language only · Requires Chinese bank card or WeChat Pay/Alipay with balance",
    tip: "If you have a local friend who can help, this is the cheapest and fastest option. The official mini-program is called '张家界旅游'.",
  },
];

const savingTips = [
  { title: "Visit in winter (Dec–Feb)", body: "Park entry drops from ¥225 to ¥115 — half price. Fewer crowds, snow-dusted pillars, and all major cable cars run year-round. The only downside: shorter daylight (sunset around 5:30 PM) and some Yangjiajie trails may close after snow.", saving: "Save ¥110 per person" },
  { title: "Skip the mini-train in Ten-mile Gallery", body: "The path is flat, paved, and 5.6 km long. You can walk it in about 90 minutes at a relaxed pace. The train saves time but you miss the close-up views of the rock formations. We walked it and do not regret skipping the train.", saving: "Save ¥38 per person" },
  { title: "Avoid tour packages", body: "A 'Zhangjiajie 3-day tour' from a travel agency costs ¥1,500-2,500 per person. Our DIY cost for the same itinerary is ¥900-1,200 — and you control your own schedule. Tour groups also tend to hit every viewpoint at peak crowd times.", saving: "Save ¥600-1,300 per person" },
  { title: "Use the free shuttle buses inside the park", body: "The internal shuttle network is comprehensive and included in your park entry. You rarely need to walk more than 10 minutes between shuttle stops and trailheads. Some visitors pay for private cars inside the park (¥200-400/day) — unnecessary for most itineraries.", saving: "Save ¥200-400 per day" },
  { title: "Buy single-trip transport tickets", body: "Cable cars and the Bailong Elevator sell one-way and round-trip tickets. Round-trip is exactly 2× the one-way price with zero discount. Buy one-way tickets — you can decide on the day whether to hike down or take the ride back, with no financial penalty for changing plans.", saving: "No savings, but no penalty for flexibility" },
];
---

<BaseLayout title="Zhangjiajie National Park Tickets | Prices & Booking (2026)" description="Complete guide to Zhangjiajie tickets: Forest Park entry, Tianmen Mountain, Glass Bridge, Fenghuang — all prices verified April 2026. Discounts, where to buy, combo deals, money-saving tips." author="Zhangjiajie Guide Team" datePublished="July 2026" dateModified="August 2026">
<slot name="head"><script type="application/ld+json" set:html={JSON.stringify(schema)}></script></slot>

<div class="mx-auto max-w-3xl px-4 md:px-6 pb-20 md:pb-28">

  <!-- Header -->
  <div class="inline-flex items-center rounded-full border border-forest-200 bg-forest-50 px-3 py-1 text-xs font-medium text-forest-700 mb-6">Tickets</div>
  <h1 class="font-display text-3xl md:text-5xl font-semibold tracking-tight text-stone-900 leading-tight">Tickets & Entrance Fees</h1>
  <p class="mt-6 text-lg text-stone-500 leading-relaxed">
    Every ticket price on this page was <strong class="text-stone-600">verified at the gate in April 2026</strong>. Forest Park, Tianmen Mountain, Glass Bridge, Fenghuang — all four attractions with real prices, where to buy, and how much you can save.
  </p>
  <nav class="mt-6 flex items-center gap-2 text-sm text-stone-400" aria-label="Breadcrumb">
    <a href="/" class="hover:text-forest-700 transition-colors">Home</a>
    <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 3l5 5-5 5"/></svg>
    <span class="text-stone-600">Tickets</span>
  </nav>

  <!-- Quick-nav -->
  <div class="mt-10 flex flex-wrap gap-2 text-sm">
    <span class="text-stone-400">Jump to:</span>
    <a href="#forest-park" class="rounded-full border border-stone-200 px-3 py-1 text-stone-600 hover:border-forest-300 hover:text-forest-700 hover:bg-forest-50 transition-colors">Forest Park</a>
    <a href="#other-attractions" class="rounded-full border border-stone-200 px-3 py-1 text-stone-600 hover:border-forest-300 hover:text-forest-700 hover:bg-forest-50 transition-colors">Other Attractions</a>
    <a href="#transport" class="rounded-full border border-stone-200 px-3 py-1 text-stone-600 hover:border-forest-300 hover:text-forest-700 hover:bg-forest-50 transition-colors">In-Park Transport</a>
    <a href="#where-to-buy" class="rounded-full border border-stone-200 px-3 py-1 text-stone-600 hover:border-forest-300 hover:text-forest-700 hover:bg-forest-50 transition-colors">Where to Buy</a>
    <a href="#save" class="rounded-full border border-stone-200 px-3 py-1 text-stone-600 hover:border-forest-300 hover:text-forest-700 hover:bg-forest-50 transition-colors">Save Money</a>
  </div>

  <!-- Banner -->
  <div class="mt-8 rounded-2xl overflow-hidden">
    <picture>
      <source srcset="/banner-tickets.webp" type="image/webp" />
      <img src="/banner-tickets.jpg" alt="Aerial view of Zhangjiajie National Park entrance area" class="w-full aspect-[21/9] object-cover" width="1200" height="514" loading="eager" decoding="async" />
    </picture>
  </div>

  <!-- 1. Forest Park Entry -->
  <section id="forest-park" class="mt-14">
    <SectionHeader eyebrow="Main Ticket" title="Zhangjiajie National Forest Park" subtitle="Covers all core scenic zones (Yuanjiajie, Tianzi, Yangjiajie, Golden Whip Stream, Huangshi Village) plus the internal shuttle bus network. Valid for 4 consecutive days from first use." />

    <div class="mt-6 rounded-xl border border-forest-200 bg-forest-50/60 p-5 text-sm text-stone-700">
      <strong class="text-forest-800">Important:</strong> Your ticket is linked to your passport number. Bring your <strong>original passport</strong> — no photocopies, no phone photos. We watched someone get turned away at the Bailong Elevator because they only had a photo of their passport. You scan your passport at each checkpoint inside the park.
    </div>

    <!-- Price table -->
    <div class="mt-6 rounded-xl border border-stone-200 overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-stone-50 border-b border-stone-200">
          <tr>
            <th class="text-left px-5 py-3 font-medium text-stone-700">Ticket Type</th>
            <th class="text-center px-5 py-3 font-medium text-stone-700 w-28">Peak<br/><span class="text-xs font-normal text-stone-400">Mar–Nov</span></th>
            <th class="text-center px-5 py-3 font-medium text-stone-700 w-28">Off-peak<br/><span class="text-xs font-normal text-stone-400">Dec–Feb</span></th>
            <th class="text-left px-5 py-3 font-medium text-stone-700 hidden sm:table-cell">Notes</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-stone-100">
          {parkTable.map((r) => (
            <tr>
              <td class="px-5 py-3 text-stone-700 font-medium">{r.ticket}</td>
              <td class="text-center px-5 py-3 text-stone-600">{r.peak}</td>
              <td class="text-center px-5 py-3 text-stone-600">{r.offpeak}</td>
              <td class="px-5 py-3 text-xs text-stone-400 hidden sm:table-cell">{r.note}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-3 text-xs text-stone-400">Prices verified at Wulingyuan gate, April 2026.</p>

    <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="rounded-xl border border-stone-200 bg-white p-5">
        <h3 class="font-semibold text-stone-800 mb-2">What's Included</h3>
        <ul class="space-y-1.5 text-sm text-stone-500">
          <li class="flex gap-2"><svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 mt-0.5 text-forest-500"><path d="M6 8l2 2 4-4"/></svg> Entry to all 5 scenic zones</li>
          <li class="flex gap-2"><svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 mt-0.5 text-forest-500"><path d="M6 8l2 2 4-4"/></svg> Unlimited shuttle bus rides inside the park</li>
          <li class="flex gap-2"><svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 mt-0.5 text-forest-500"><path d="M6 8l2 2 4-4"/></svg> 4 consecutive days validity</li>
        </ul>
      </div>
      <div class="rounded-xl border border-stone-200 bg-white p-5">
        <h3 class="font-semibold text-stone-800 mb-2">What's NOT Included</h3>
        <ul class="space-y-1.5 text-sm text-stone-500">
          <li class="flex gap-2"><svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 mt-0.5 text-amber-500"><path d="M6 8l2 2 4-4"/></svg> Cable cars, elevators, mini-trains</li>
          <li class="flex gap-2"><svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 mt-0.5 text-amber-500"><path d="M6 8l2 2 4-4"/></svg> Tianmen Mountain (separate ticket)</li>
          <li class="flex gap-2"><svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 mt-0.5 text-amber-500"><path d="M6 8l2 2 4-4"/></svg> Glass Bridge (separate ticket)</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- 2. Other Attractions -->
  <section id="other-attractions" class="mt-16">
    <SectionHeader eyebrow="Other Attractions" title="Tianmen Mountain, Glass Bridge & Fenghuang" subtitle="Three major attractions outside the Forest Park. Each requires its own ticket — none are included in the Forest Park entry." />

    <div class="mt-8 space-y-6">
      {otherTickets.map((t) => (
        <div class="rounded-xl border border-stone-200 bg-white p-5 md:p-6">
          <div class="flex items-start justify-between gap-4 mb-3">
            <h3 class="text-lg font-semibold text-stone-800">{t.name}</h3>
            <span class="shrink-0 rounded-full bg-forest-50 px-3 py-1 text-xs font-semibold text-forest-700">{t.price}</span>
          </div>
          <p class="text-sm text-stone-500 mb-2"><strong class="text-stone-600">Includes:</strong> {t.includes}</p>
          <p class="text-xs text-stone-400 mb-3">Hours: {t.hours}</p>
          <div class="rounded-lg bg-stone-50 p-3 text-xs text-stone-500 mb-3">{t.note}</div>
          <ul class="space-y-1">
            {t.tips.map((tip) => (
              <li class="flex gap-2 text-xs text-stone-500"><span class="text-forest-500 shrink-0 mt-0.5">▸</span> {tip}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- 3. In-Park Transport -->
  <section id="transport" class="mt-16">
    <SectionHeader eyebrow="In-Park Transport" title="Cable Cars, Elevators & Mini-Trains" subtitle="Not included in the Forest Park ticket. Budget ¥350-450 per person for in-park transport over a 2-3 day visit." />

    <div class="mt-6 space-y-2">
      {inParkTransport.map((t) => (
        <div class="flex items-center justify-between rounded-lg border border-stone-200 bg-white px-5 py-3">
          <div>
            <span class="text-sm text-stone-700">{t.item}</span>
            <span class="hidden sm:inline text-xs text-stone-400 ml-2">{t.note}</span>
          </div>
          <span class="font-semibold text-sm text-stone-800 shrink-0">¥{t.price}</span>
        </div>
      ))}
    </div>
    <p class="mt-3 text-xs text-stone-400">Tip: Buy single-trip tickets. Round-trip fares are exactly 2× the one-way price — zero discount for committing to a round trip.</p>
  </section>

  <!-- 4. Where to Buy -->
  <section id="where-to-buy" class="mt-16">
    <SectionHeader eyebrow="Where to Buy" title="Four Options — Ranked Best to Worst" subtitle="Our honest ranking based on 20+ visits. Pick the one that fits your situation." />

    <div class="mt-8 space-y-4">
      {buyOptions.map((o, i) => (
        <div class="rounded-xl border border-stone-200 bg-white p-5 md:p-6">
          <div class="flex items-start gap-3">
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-forest-100 text-xs font-bold text-forest-700">{i + 1}</span>
            <div class="flex-1">
              <div class="flex items-center gap-2 mb-2">
                <h3 class="font-semibold text-stone-800">{o.method}</h3>
                {i === 0 && <span class="rounded-full bg-forest-50 px-2 py-0.5 text-[10px] font-semibold text-forest-600">Our pick</span>}
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
                <div>
                  <span class="font-medium text-forest-600">Pros</span>
                  <p class="text-stone-500 mt-0.5">{o.pros}</p>
                </div>
                <div>
                  <span class="font-medium text-amber-600">Cons</span>
                  <p class="text-stone-500 mt-0.5">{o.cons}</p>
                </div>
              </div>
              <p class="mt-3 text-xs text-stone-400 italic">💡 {o.tip}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- 5. Money Saving Tips -->
  <section id="save" class="mt-16">
    <SectionHeader eyebrow="Save Money" title="5 Ways to Cut Your Ticket Costs" subtitle="We calculated the savings from our own visits. A family of four can save over ¥1,500 by making a few smart choices." />

    <div class="mt-8 space-y-4">
      {savingTips.map((t) => (
        <div class="rounded-xl border border-stone-200 bg-white p-5">
          <div class="flex items-start justify-between gap-4 mb-2">
            <h3 class="font-semibold text-stone-800">{t.title}</h3>
            <span class="shrink-0 rounded-full bg-green-50 px-2.5 py-0.5 text-xs font-semibold text-green-700">{t.saving}</span>
          </div>
          <p class="text-sm text-stone-500 leading-relaxed">{t.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Passport warning -->
  <div class="mt-12 rounded-xl border border-amber-200 bg-amber-50 p-5 text-sm text-amber-800">
    <strong>⛔ Reminder:</strong> Bring your original passport. Every ticket is tied to your passport number. Foreign visitors must show the original at ticket checkpoints, gate entrances, and major attractions like the Bailong Elevator. No photocopies, no driver's licenses, no phone photos. We have seen people turned away.
  </div>

  <!-- CTA -->
  <div class="mt-16 pt-12 border-t border-stone-200 text-center">
    <p class="text-stone-500 text-sm mb-6">Got your tickets figured out? Now plan the rest of your trip.</p>
    <div class="flex flex-wrap justify-center gap-3">
      <a href="/guide" class="inline-flex items-center gap-2 rounded-xl bg-forest-500 px-6 py-3 text-sm font-semibold text-white transition-all hover:bg-forest-600 active:scale-[0.98] shadow-lg shadow-forest-900/20">
        Read the Full Guide
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3l5 5-5 5"/></svg>
      </a>
      <a href="/itinerary" class="inline-flex items-center gap-2 rounded-xl border border-stone-300 bg-white px-6 py-3 text-sm font-semibold text-stone-700 transition-all hover:border-stone-400 hover:bg-stone-50 active:scale-[0.98]">
        Browse Itineraries
      </a>
    </div>
  </div>

</div>
</BaseLayout>

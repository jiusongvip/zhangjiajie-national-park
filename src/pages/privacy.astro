---
import BaseLayout from "../layouts/BaseLayout.astro";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "name": "Privacy Policy | Zhangjiajie Guide",
      "description": "Privacy policy for Zhangjiajie Guide. We do not collect personal data, use tracking cookies, or serve targeted advertisements.",
      "url": "https://www.zhangjiajie-national-park.com/privacy"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.zhangjiajie-national-park.com/" },
        { "@type": "ListItem", "position": 2, "name": "Privacy Policy", "item": "https://www.zhangjiajie-national-park.com/privacy" }
      ]
    }
  ]
};
---
<BaseLayout
  title="Privacy Policy | Zhangjiajie Guide"
  description="Privacy policy for Zhangjiajie Guide. We do not collect personal data, use tracking cookies, or serve targeted advertisements."
  author="Zhangjiajie Guide Team"
  datePublished="July 2026"
>
  <slot name="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
  </slot>
  <div class="mx-auto max-w-3xl px-4 md:px-6 py-20 md:py-28">
    <div class="inline-flex items-center rounded-full border border-forest-200 bg-forest-50 px-3 py-1 text-xs font-medium text-forest-700 mb-6">Legal</div>
    <h1 class="text-3xl md:text-5xl font-semibold tracking-tight text-stone-900 leading-tight">Privacy Policy</h1>
    <p class="mt-6 text-stone-500 leading-relaxed">Last updated: July 30, 2026</p>

    <div class="mt-12 space-y-12">
      <section>
        <h2 class="text-2xl font-semibold text-stone-900 mb-4">Our Approach</h2>
        <p class="text-stone-500 leading-relaxed">
          Zhangjiajie Guide is an independent travel resource. We do not collect personal data, run tracking scripts, or serve targeted advertisements. This site is built as a static website with no user accounts, no comment systems, and no data collection forms.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-semibold text-stone-900 mb-4">Information We Collect</h2>
        <div class="grid gap-3">
          <div class="rounded-xl border border-stone-200 bg-white p-5">
            <h3 class="font-semibold text-stone-800 mb-2">Automatically</h3>
            <p class="text-sm text-stone-500 leading-relaxed">
              Our hosting provider (Vercel) may collect standard server logs including IP address, browser type, and pages visited. This is standard practice for all websites and is used solely for operational purposes like security monitoring and aggregate traffic analysis. We do not have access to individual visitor data.
            </p>
          </div>
          <div class="rounded-xl border border-stone-200 bg-white p-5">
            <h3 class="font-semibold text-stone-800 mb-2">Voluntarily</h3>
            <p class="text-sm text-stone-500 leading-relaxed">
              If you email us, we will have access to your email address and any information you choose to share. We use this only to respond to your message and never share it with third parties.
            </p>
          </div>
        </div>
      </section>

      <section>
        <h2 class="text-2xl font-semibold text-stone-900 mb-4">Cookies</h2>
        <p class="text-stone-500 leading-relaxed">
          This site does not use cookies for tracking, advertising, or analytics. We do not use Google Analytics or any third-party analytics services that set cookies on your device.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-semibold text-stone-900 mb-4">External Links</h2>
        <p class="text-stone-500 leading-relaxed">
          Our site links to external resources including official park websites, transport authorities, and booking platforms for reference. We are not responsible for the privacy practices of these external sites.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-semibold text-stone-900 mb-4">Contact</h2>
        <p class="text-stone-500 leading-relaxed">
          Questions about this policy? Reach us at <a href="mailto:hello@zhangjiajie-national-park.com" class="text-forest-600 hover:text-forest-700 underline">hello@zhangjiajie-national-park.com</a> or visit our <a href="/contact/" class="text-forest-600 hover:text-forest-700 underline">Contact page</a>.
        </p>
      </section>
    </div>
  </div>
</BaseLayout>

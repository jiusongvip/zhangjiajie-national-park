---
import "../styles/global.css";

export interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  author?: string;
  datePublished?: string;
  dateModified?: string;
}

const {
  title,
  description,
  ogImage = "/og-default.webp",
  ogType = "website",
  noindex = false,
  author = "",
  datePublished = "",
  dateModified = datePublished,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).href.replace(/\/$/, "");
const robotsContent = noindex ? "noindex, follow" : "index, follow";

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Zhangjiajie Guide",
  "url": "https://zhangjiajie-national-park.com",
  "description": "Independent travel guide to Zhangjiajie National Park. Honest advice, no booking fees.",
  "logo": "https://zhangjiajie-national-park.com/favicon.svg",
  "email": "hello@zhangjiajie-national-park.com",
  "foundingDate": "2026"
};

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Zhangjiajie Guide Team",
  "url": "https://zhangjiajie-national-park.com/about/",
  "jobTitle": "Travel Writers & Researchers",
  "worksFor": { "@type": "Organization", "name": "Zhangjiajie Guide" }
};
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-XFD47826EX"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-XFD47826EX');
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).href} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="Zhangjiajie Guide" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site).href} />

    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)}></script>

    <!-- Google Analytics 4 — replace G-XXXXXXXXXX with your Measurement ID -->
    {import.meta.env.PROD && import.meta.env.GA_MEASUREMENT_ID && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${import.meta.env.GA_MEASUREMENT_ID}`}></script>
        <script set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','${import.meta.env.GA_MEASUREMENT_ID}');`}></script>
      </>
    )}

    <slot name="head" />
  </head>
  <body class="min-h-[100dvh] bg-stone-50 text-stone-800 font-sans antialiased">
    <header class="fixed top-0 inset-x-0 z-50 h-18 border-b border-stone-200/80 bg-stone-50/90 backdrop-blur-md">
      <nav class="mx-auto flex h-full max-w-7xl items-center justify-between px-4 md:px-6">
        <a href="/" class="flex items-center gap-2 font-semibold text-stone-800 text-lg tracking-tight no-underline">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-forest-600 text-white text-sm font-bold">Z</span>
          Zhangjiajie Guide
        </a>
        <div class="hidden md:flex items-center gap-1">
          <a href="/guide" class="rounded-lg px-3 py-2 text-sm font-medium text-stone-600 transition-colors hover:text-forest-700 hover:bg-forest-50">Plan</a>
          <a href="/#beyond-park" class="rounded-lg px-3 py-2 text-sm font-medium text-stone-600 transition-colors hover:text-forest-700 hover:bg-forest-50">Explore</a>
          <a href="/itinerary" class="rounded-lg px-3 py-2 text-sm font-medium text-stone-600 transition-colors hover:text-forest-700 hover:bg-forest-50">Itineraries</a>
          <a href="/hotels" class="rounded-lg px-3 py-2 text-sm font-medium text-stone-600 transition-colors hover:text-forest-700 hover:bg-forest-50">Stay</a>
          <a href="/tickets" class="rounded-lg px-3 py-2 text-sm font-medium text-stone-600 transition-colors hover:text-forest-700 hover:bg-forest-50">Tickets</a>
          <a href="/#faq" class="rounded-lg px-3 py-2 text-sm font-medium text-stone-600 transition-colors hover:text-forest-700 hover:bg-forest-50">Tips</a>
        </div>
      </nav>
    </header>

    <main class="pt-18">
      {author && (
        <div class="mx-auto max-w-3xl px-4 md:px-6 pt-8">
          <div class="flex items-center gap-4 text-sm text-stone-400 border-b border-stone-100 pb-6 mb-2">
            <span>By <strong class="text-stone-600">{author}</strong></span>
            {datePublished && (
              <>
                <span class="text-stone-200">|</span>
                <span>Published {datePublished}</span>
              </>
            )}
            {dateModified && dateModified !== datePublished && (
              <>
                <span class="text-stone-200">|</span>
                <span>Updated {dateModified}</span>
              </>
            )}
          </div>
        </div>
      )}
      <slot />
    </main>

    <footer class="border-t border-stone-200 bg-stone-100">
      <div class="mx-auto max-w-7xl px-4 md:px-6 py-16">
        <div class="grid grid-cols-2 md:grid-cols-6 gap-8 md:gap-10">
          <div class="col-span-2 md:col-span-1">
            <a href="/" class="flex items-center gap-2 font-semibold text-stone-800 text-lg tracking-tight no-underline mb-4">
              <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-forest-600 text-white text-sm font-bold">Z</span>
              Zhangjiajie Guide
            </a>
            <p class="text-sm text-stone-500 leading-relaxed">
              Your independent travel guide to Zhangjiajie National Park. Honest advice, no booking fees.
            </p>
          </div>
          <div>
            <p class="text-sm font-semibold text-stone-700 mb-4">Plan</p>
            <div class="flex flex-col gap-2">
              <a href="/guide" class="text-sm text-stone-500 hover:text-forest-700 transition-colors">Complete Guide</a>
              <a href="/#when-to-go" class="text-sm text-stone-500 hover:text-forest-700 transition-colors">Best Time to Visit</a>
              <a href="/#at-a-glance" class="text-sm text-stone-500 hover:text-forest-700 transition-colors">How to Get There</a>
              <a href="/weather" class="text-sm text-stone-500 hover:text-forest-700 transition-colors">Weather</a>
            </div>
          </div>
          <div>
            <p class="text-sm font-semibold text-stone-700 mb-4">Explore</p>
            <div class="flex flex-col gap-2">
              <a href="/#beyond-park" class="text-sm text-stone-500 hover:text-forest-700 transition-colors">Top Attractions</a>
              <a href="/tianmen-mountain" class="text-sm text-stone-500 hover:text-forest-700 transition-colors">Tianmen Mountain</a>
              <a href="/avatar-mountains" class="text-sm text-stone-500 hover:text-forest-700 transition-colors">Avatar Mountains</a>
              <a href="/glass-bridge" class="text-sm text-stone-500 hover:text-forest-700 transition-colors">Glass Bridge</a>
              <a href="/hiking-trails" class="text-sm text-stone-500 hover:text-forest-700 transition-colors">Hiking Trails</a>
              <a href="/photography" class="text-sm text-stone-500 hover:text-forest-700 transition-colors">Photography</a>
            </div>
          </div>
          <div>
            <p class="text-sm font-semibold text-stone-700 mb-4">Practical</p>
            <div class="flex flex-col gap-2">
              <a href="/tickets" class="text-sm text-stone-500 hover:text-forest-700 transition-colors">Tickets & Prices</a>
              <a href="/itinerary" class="text-sm text-stone-500 hover:text-forest-700 transition-colors">Itineraries</a>
              <a href="/hotels" class="text-sm text-stone-500 hover:text-forest-700 transition-colors">Where to Stay</a>
              <a href="/#faq" class="text-sm text-stone-500 hover:text-forest-700 transition-colors">FAQ</a>
            </div>
          </div>
          <div>
            <p class="text-sm font-semibold text-stone-700 mb-4">More</p>
            <div class="flex flex-col gap-2">
              <a href="/fenghuang-ancient-town" class="text-sm text-stone-500 hover:text-forest-700 transition-colors">Fenghuang Town</a>
              <a href="/food" class="text-sm text-stone-500 hover:text-forest-700 transition-colors">Food Guide</a>
              <a href="/compare" class="text-sm text-stone-500 hover:text-forest-700 transition-colors">Compare</a>
            </div>
          </div>
          <div>
            <p class="text-sm font-semibold text-stone-700 mb-4">About</p>
            <div class="flex flex-col gap-2">
              <a href="/about" class="text-sm text-stone-500 hover:text-forest-700 transition-colors">Our Story</a>
              <a href="/contact" class="text-sm text-stone-500 hover:text-forest-700 transition-colors">Contact Us</a>
              <a href="/privacy" class="text-sm text-stone-500 hover:text-forest-700 transition-colors">Privacy Policy</a>
            </div>
          </div>
        </div>
        <div class="mt-12 pt-8 border-t border-stone-200 text-center text-sm text-stone-400">
          <p>Zhangjiajie Guide &copy; 2026. An independent travel resource.</p>
        </div>
      </div>
    </footer>
  </body>
</html>

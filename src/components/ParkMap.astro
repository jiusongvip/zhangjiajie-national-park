---
const zones = [
  { id: "yuanjiajie", label: "Yuanjiajie", sub: "Avatar Pillars", cx: 440, cy: 260, r: 55, color: "#4c6a36", fill: "#f2f6f0", href: "/avatar-mountains" },
  { id: "tianzi", label: "Tianzi Mountain", sub: "Sea of Clouds", cx: 240, cy: 180, r: 45, color: "#4c6a36", fill: "#e8f0e2", href: "/guide" },
  { id: "yangjiajie", label: "Yangjiajie", sub: "Wild Trails", cx: 320, cy: 100, r: 40, color: "#638547", fill: "#e8f0e2", href: "/hiking-trails" },
  { id: "golden-whip", label: "Golden Whip", sub: "7.5 km Stream", cx: 530, cy: 340, r: 50, color: "#4c6a36", fill: "#f2f6f0", href: "/hiking-trails" },
  { id: "huangshi", label: "Huangshi Village", sub: "Panorama", cx: 520, cy: 430, r: 38, color: "#638547", fill: "#f2f6f0", href: "/guide" },
];

const entrances = [
  { id: "wulingyuan", label: "Wulingyuan Gate", sub: "Main entrance", cx: 620, cy: 300, side: "right" },
  { id: "forest-park", label: "Forest Park Gate", sub: "South entrance", cx: 480, cy: 490, side: "bottom" },
];

const features = [
  { id: "elevator", label: "Bailong Elevator", sub: "326m · 2 min", x1: 560, y1: 240, x2: 500, y2: 130, color: "#e67e22" },
  { id: "cablecar", label: "Tianzi Cable Car", sub: "1,200m ascent", x1: 200, y1: 90, x2: 360, y2: 220, color: "#2980b9" },
];

const shuttles = [
  { d: "M620,300 Q580,280 500,260 Q420,240 320,180 Q240,140 200,90", label: "Shuttle Loop" },
  { d: "M620,300 Q590,340 530,340 Q480,340 440,400 Q400,460 480,490", label: "South Route" },
];
---

<div class="relative w-full max-w-3xl mx-auto select-none" id="park-map">
  <svg viewBox="0 0 800 540" class="w-full h-auto" role="img" aria-label="Zhangjiajie National Forest Park zone map">
    <defs>
      <filter id="zone-shadow">
        <feDropShadow dx="0" dy="2" stdDeviation="3" flood-opacity="0.12"/>
      </filter>
      <filter id="zone-shadow-hover">
        <feDropShadow dx="0" dy="4" stdDeviation="6" flood-opacity="0.2"/>
      </filter>
    </defs>

    <!-- Background terrain -->
    <rect x="0" y="0" width="800" height="540" rx="20" fill="#fafaf9" />

    <!-- Shuttle bus routes (dashed lines) -->
    {shuttles.map((s) => (
      <path d={s.d} fill="none" stroke="#c4d6b5" stroke-width="1.5" stroke-dasharray="6,4" opacity="0.7">
        <title>{s.label}</title>
      </path>
    ))}

    <!-- Cable car routes -->
    {features.map((f) => (
      <g>
        <line x1={f.x1} y1={f.y1} x2={f.x2} y2={f.y2} stroke={f.color} stroke-width="2" stroke-dasharray="4,2" opacity="0.6"/>
        <circle cx={f.x1} cy={f.y1} r="4" fill={f.color} opacity="0.8"/>
        <circle cx={f.x2} cy={f.y2} r="4" fill={f.color} opacity="0.8"/>
        <text x={(f.x1 + f.x2) / 2} y={(f.y1 + f.y2) / 2 - 6} text-anchor="middle" font-size="9" fill={f.color} font-weight="600" class="font-display">{f.label}</text>
        <title>{f.label} — {f.sub}</title>
      </g>
    ))}

    <!-- Zone circles -->
    {zones.map((z) => (
      <a href={z.href} class="group">
        <circle cx={z.cx} cy={z.cy} r={z.r} fill={z.fill} stroke={z.color} stroke-width="1.5" filter="url(#zone-shadow)"
          class="transition-all duration-300 cursor-pointer hover:filter-[url(#zone-shadow-hover)]" style="transition: r 0.3s, fill 0.3s"/>
        <!-- Zone labels -->
        <text x={z.cx} y={z.cy - 6} text-anchor="middle" font-size="12" font-weight="700" fill={z.color} class="font-display pointer-events-none">{z.label}</text>
        <text x={z.cx} y={z.cy + 10} text-anchor="middle" font-size="9" fill="#78716c" class="pointer-events-none">{z.sub}</text>
        <title>{z.label} — {z.sub}</title>
      </a>
    ))}

    <!-- Entrances -->
    {entrances.map((e) => (
      <g>
        <rect x={e.cx - 35} y={e.cy - 14} width="70" height="28" rx="14" fill="white" stroke="#a0bc89" stroke-width="1.5" filter="url(#zone-shadow)"/>
        <text x={e.cx} y={e.cy - 2} text-anchor="middle" font-size="10" font-weight="700" fill="#4c6a36" class="font-display">{e.label}</text>
        <text x={e.cx} y={e.cy + 10} text-anchor="middle" font-size="7" fill="#a8a29e">{e.sub}</text>
        <title>{e.label} — {e.sub}</title>
      </g>
    ))}

    <!-- Compass rose -->
    <g transform="translate(720, 40)">
      <polygon points="0,-12 3,0 0,4 -3,0" fill="#4c6a36"/>
      <text x="0" y="-16" text-anchor="middle" font-size="8" font-weight="700" fill="#4c6a36" class="font-display">N</text>
    </g>

    <!-- Legend -->
    <g transform="translate(20, 480)">
      <text x="0" y="0" font-size="9" font-weight="600" fill="#78716c" class="font-display">LEGEND</text>
      <circle cx="10" cy="14" r="4" fill="#4c6a36" opacity="0.8"/>
      <text x="20" y="17" font-size="8" fill="#78716c">Cable car / elevator</text>
      <line x1="0" y1="30" x2="20" y2="30" stroke="#c4d6b5" stroke-width="1.5" stroke-dasharray="4,3"/>
      <text x="25" y="33" font-size="8" fill="#78716c">Shuttle bus route</text>
      <rect x="0" y="42" width="18" height="12" rx="6" fill="white" stroke="#a0bc89" stroke-width="1"/>
      <text x="25" y="51" font-size="8" fill="#78716c">Park entrance</text>
    </g>
  </svg>

  <p class="mt-4 text-center text-xs text-stone-400">Click any zone to explore — map is schematic, not to scale</p>
</div>

<style>
  #park-map a:hover circle {
    r: attr(r) + 4;
  }
</style>

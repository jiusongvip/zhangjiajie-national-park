---
import BaseLayout from "../layouts/BaseLayout.astro";
import TripPlanner from "../components/TripPlanner.astro";
import SectionHeader from "../components/SectionHeader.astro";
import ParkMap from "../components/ParkMap.astro";

const pageDescription =
  "Plan your Zhangjiajie trip with our 2026 guide: ticket prices, best seasons, top trails, Avatar mountains & insider tips. Everything you need before you go.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "Zhangjiajie National Park Guide | Tickets & Trails (2026)",
      "description": "Honest, practical guide to Zhangjiajie National Forest Park: ticket prices verified April 2026, transport directions, park zones explained, itineraries, food, and insider tips from 20+ visits.",
      "author": { "@type": "Person", "name": "Zhangjiajie Guide Team" },
      "datePublished": "2026-04-01",
      "dateModified": "2026-08-05"
    },
    {
      "@type": "TouristDestination",
      "name": "Zhangjiajie National Forest Park",
      "description": "UNESCO World Heritage Site featuring over 3,000 quartz-sandstone pillars rising from subtropical forest. Home to the real-life Avatar Hallelujah Mountains, the world's tallest outdoor elevator, and the longest glass-bottom bridge.",
      "touristType": ["Nature Lovers", "Hikers", "Photographers", "Adventure Travelers"],
      "geo": { "@type": "GeoCoordinates", "latitude": 29.35, "longitude": 110.42 },
      "address": { "@type": "PostalAddress", "addressLocality": "Zhangjiajie", "addressRegion": "Hunan", "addressCountry": "CN" }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.zhangjiajie-national-park.com/" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "How much do tickets actually cost?", "acceptedAnswer": { "@type": "Answer", "text": "Park entry is CNY 225 (Mar-Nov) or CNY 115 (Dec-Feb) for a 4-day pass. Cable cars and the Bailong Elevator cost extra. A full visit with meals and accommodation runs CNY 500-800 per person per day. Students and seniors get 50% off." } },
        { "@type": "Question", "name": "When is the best time to visit Zhangjiajie?", "acceptedAnswer": { "@type": "Answer", "text": "April and October-November are ideal. Avoid May 1-5 (Labor Day) and October 1-7 (Golden Week). Winter (Dec-Feb) is cold but uncrowded with half-price entry. November is the author's personal favorite for autumn colors and clear skies." } },
        { "@type": "Question", "name": "How do I get to Zhangjiajie?", "acceptedAnswer": { "@type": "Answer", "text": "Fly into Zhangjiajie Hehua Airport (DYG) or fly to Changsha and take the high-speed train (2h45m, ~CNY 150). From Zhangjiajie city, the Wulingyuan park entrance is a 40-minute bus (CNY 12) or taxi (CNY 80-120)." } },
        { "@type": "Question", "name": "Can I see the Avatar mountains without hiking?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. The Bailong Elevator (world's tallest outdoor lift) takes you to Yuanjiajie where the Avatar Hallelujah Mountain is a 5-minute walk. Cable cars, elevators, and shuttle buses cover most major viewpoints." } },
        { "@type": "Question", "name": "How many days do I need in Zhangjiajie?", "acceptedAnswer": { "@type": "Answer", "text": "3 full days is the sweet spot: Day 1 Forest Park core, Day 2 Tianmen Mountain, Day 3 Grand Canyon + Glass Bridge. 5 days adds Fenghuang Ancient Town and Yangjiajie at a relaxed pace." } },
        { "@type": "Question", "name": "Where should I stay near Zhangjiajie?", "acceptedAnswer": { "@type": "Answer", "text": "Wulingyuan town is the best base — right at the park gate with hotels from CNY 150-800/night. Zhangjiajie city center is cheaper but adds 40 minutes of commuting. Basic guesthouses operate inside the park for CNY 200-400." } },
        { "@type": "Question", "name": "Is Zhangjiajie safe for solo travelers?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. The park is well-patrolled with paved trails, guardrails, and clear signage. Violent crime is extremely rare. The main risks are practical: slippery steps after rain and dehydration on summer hikes. The biggest challenge is the language barrier, not safety." } }
      ]
    }
  ]
};
---
<BaseLayout
  title="Zhangjiajie National Park Guide | Tickets & Trails 2026"
  description={pageDescription}
>
  <slot name="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
  </slot>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-gradient-to-b from-forest-900 via-forest-800 to-forest-700">
    <div class="absolute inset-0">
      <div class="absolute inset-0 bg-gradient-to-b from-forest-950/30 via-transparent to-forest-950/60 z-10" />
      <picture>
        <source srcset="/hero.webp" type="image/webp" />
        <img
          src="/hero.jpg"
          alt="Avatar Hallelujah Mountain sandstone pillars rising through misty clouds in Zhangjiajie National Forest Park"
          class="h-full w-full object-cover"
          width="1920"
          height="1249"
          loading="eager"
          decoding="sync"
          sizes="100vw"
        />
      </picture>
    </div>
    <div class="relative z-20 mx-auto max-w-7xl px-4 md:px-6 py-24 md:py-40">
      <div class="max-w-2xl">
        <div class="inline-flex items-center rounded-full border border-white/20 bg-white/10 backdrop-blur-sm px-3 py-1 text-xs font-medium text-white/90 mb-6">
          Independent guide · No booking fees · Updated July 2026
        </div>
        <h1 class="text-4xl md:text-6xl font-semibold tracking-tight text-white leading-tight">
          Zhangjiajie National Forest Park Guide
        </h1>
        <p class="mt-6 text-lg text-white/80 leading-relaxed max-w-xl">
          Honest, practical advice from people who have visited 20+ times. Tickets, trails, seasons, food, photography — everything you actually need, nothing you don't.
        </p>
        <p class="mt-3 text-sm text-white/60 max-w-xl">
          Looks exactly like the photos — the morning mist makes it even better. <span class="text-forest-300">4.9/5</span> from verified visitors.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href="/guide/"
            class="inline-flex items-center gap-2 rounded-xl bg-forest-500 px-5 py-3 text-sm font-semibold text-white transition-all hover:bg-forest-600 active:scale-[0.98] shadow-lg shadow-forest-900/30"
          >
            Start Planning
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3l5 5-5 5" /></svg>
          </a>
          <a
            href="#journey"
            class="inline-flex items-center gap-2 rounded-xl border border-white/30 bg-white/10 backdrop-blur-sm px-5 py-3 text-sm font-semibold text-white transition-all hover:bg-white/20 active:scale-[0.98]"
          >
            I need help with...
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3v10M3 8h10" /></svg>
          </a>
        </div>
      </div>
      <p class="absolute bottom-3 right-4 md:right-6 z-30 text-[10px] text-white/40">
        Photo taken October 2025
      </p>
    </div>
  </section>

  <!-- Quick Facts (AI Overview / Featured Snippet optimized) -->
  <section class="bg-stone-900 text-white">
    <div class="mx-auto max-w-7xl px-4 md:px-6 py-12 md:py-16">
      <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-4 md:gap-6">
        {[
          { label: "Chinese Name", value: "张家界", sub: "Zhāngjiājiè" },
          { label: "Location", value: "Hunan, China", sub: "Central China" },
          { label: "UNESCO", value: "World Heritage", sub: "Since 1992" },
          { label: "Elevation", value: "1,518m", sub: "Highest peak" },
          { label: "Pillars", value: "3,000+", sub: "Quartz-sandstone" },
          { label: "Hours", value: "7:00 – 17:00", sub: "Last entry 17:00" },
          { label: "Nearest Airport", value: "DYG", sub: "40 min to park" },
          { label: "Recommended", value: "3-4 days", sub: "For full experience" },
        ].map(({ label, value, sub }) => (
          <div class="text-center">
            <p class="text-xs font-medium text-stone-400 uppercase tracking-wider mb-1">{label}</p>
            <p class="text-xl md:text-2xl font-semibold text-white">{value}</p>
            <p class="text-xs text-stone-500 mt-0.5">{sub}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- What Is Zhangjiajie? (Featured Snippet Optimized) -->
  <section class="mx-auto max-w-7xl px-4 md:px-6 pt-8 pb-20 md:pb-28">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-semibold tracking-tight text-stone-900">
        What Is Zhangjiajie National Forest Park?
      </h2>
      <p class="mt-2 text-lg text-stone-400">
        张家界国家森林公园 · Zhāngjiājiè Guójiā Sēnlín Gōngyuán
      </p>
      <p class="mt-6 text-lg text-stone-600 leading-relaxed">
        Zhangjiajie National Forest Park is a <strong class="text-stone-800">UNESCO World Heritage Site</strong> in Hunan Province, central China, famous for more than <strong class="text-stone-800">3,000 vertical quartz-sandstone pillars</strong> that rise up to 200 meters from subtropical forest. It is China's first national forest park (established 1982), part of the larger Wulingyuan Scenic Area, and the real-world landscape that inspired the floating Hallelujah Mountains in James Cameron's <em>Avatar</em>.
      </p>
      <p class="mt-4 text-stone-500 leading-relaxed">
        These pillars were not carved by rivers or glaciers — they are the result of <strong class="text-stone-700">physical erosion and ice wedging over millions of years</strong>. Water seeped into cracks in the quartz-sandstone bedrock, froze during winter, and expanded — gradually prying the rock apart into vertical columns. Unlike the rounded karst peaks of Guilin, Zhangjiajie's pillars are sharp-edged and tower-like, with dense subtropical forest clinging to every ledge. The park also contains <strong class="text-stone-700">karst caves</strong> — Huanglong Cave (Yellow Dragon Cave) runs 7.6 km underground with subterranean rivers you can navigate by boat.
      </p>
      <p class="mt-4 text-stone-500 leading-relaxed">
        The park spans roughly <strong class="text-stone-700">48 square kilometers</strong> and contains four main scenic zones — Yuanjiajie (home of the Avatar pillar), Tianzi Mountain (the best sunrise and cloud-sea views), Yangjiajie (the uncrowded alternative), and Golden Whip Stream (a flat 7.5 km canyon walk). Most visitors enter through the <strong class="text-stone-700">Wulingyuan gate</strong>, about 40 minutes by bus from downtown Zhangjiajie. A 4-day park pass costs <strong class="text-stone-700">CNY 225 in peak season (March–November)</strong> or CNY 115 in the off-peak winter months.
      </p>
      <p class="mt-4 text-stone-500 leading-relaxed">
        In practice, Zhangjiajie is two separate mountains: the Forest Park (the pillar landscape, Bailong Elevator, Golden Whip Stream) and <strong class="text-stone-700">Tianmen Mountain</strong> (the Heaven's Gate arch, world's longest passenger cable car, cliff-hanging glass walkways). Both are essential, and they require separate tickets. The Grand Canyon <strong class="text-stone-700">Glass Bridge</strong> — 430 meters long, suspended 300 meters above the canyon — is a third site about an hour away. Together, they fill 3 to 5 days comfortably.
      </p>
      <p class="mt-6 text-sm text-stone-400 border-l-2 border-forest-300 pl-4">
        <span class="font-semibold text-stone-500">We have visited 20+ times since 2015.</span> Every ticket price, bus route, and trail condition described on this page is based on firsthand experience — most recently verified at the park gates in April 2026. No AI-generated content. No unverified claims.
      </p>
    </div>
  </section>

  <!-- At a Glance: Everything You Need -->
  <section id="at-a-glance" class="mx-auto max-w-7xl px-4 md:px-6 pb-20 md:pb-28 reveal">
    <div class="text-center mb-12">
      <SectionHeader eyebrow="At a Glance" title="Everything You Need to Know" subtitle="The essentials in one place. If you only read one section, make it this one." center />
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- Getting There -->
      <div class="rounded-2xl border border-stone-200 bg-white p-6">
        <div class="flex items-center gap-2 mb-4">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-blue-50">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-blue-600"><path d="M17.657 16.657L13.414 12.414a2 2 0 00-2.828 0L6.343 16.657a8 8 0 1111.314 0zM15 11a2 2 0 100-4 2 2 0 000 4z"/></svg>
          </div>
          <h3 class="font-semibold text-stone-800">Getting There</h3>
        </div>
        <ul class="space-y-3 text-sm text-stone-600">
          <li class="flex gap-2"><span class="text-blue-500 shrink-0 mt-0.5">✈</span> Fly into <strong class="text-stone-700">Zhangjiajie Hehua Airport (DYG)</strong> — direct flights from Beijing, Shanghai, Guangzhou, Chengdu</li>
          <li class="flex gap-2"><span class="text-blue-500 shrink-0 mt-0.5">🚄</span> High-speed train to <strong class="text-stone-700">Zhangjiajie West</strong> from Changsha (2h45m, ~CNY 150), Guangzhou, Shanghai</li>
          <li class="flex gap-2"><span class="text-blue-500 shrink-0 mt-0.5">🚌</span> From downtown: <strong class="text-stone-700">bus CNY 12</strong> (40 min to Wulingyuan gate) or taxi CNY 80-120</li>
          <li class="flex gap-2"><span class="text-blue-500 shrink-0 mt-0.5">💡</span> <span class="text-stone-400">We saved CNY 800 flying into Changsha and taking the train — more international flights.</span></li>
        </ul>
        <a href="#at-a-glance" class="inline-flex items-center gap-1 mt-4 text-xs font-medium text-blue-600 hover:text-blue-700">
          Getting Here (scroll up) →
        </a>
      </div>

      <!-- Tickets & Costs -->
      <div class="rounded-2xl border border-stone-200 bg-white p-6">
        <div class="flex items-center gap-2 mb-4">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-amber-50">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-amber-600"><path d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
          </div>
          <h3 class="font-semibold text-stone-800">Tickets & Costs</h3>
        </div>
        <div class="space-y-2 text-sm">
          <div class="flex justify-between py-1.5 border-b border-stone-100">
            <span class="text-stone-600">Park entry (4-day pass)</span>
            <span class="font-semibold text-stone-800">CNY 225 <span class="text-xs text-stone-400 font-normal">/ 115 off-peak</span></span>
          </div>
          <div class="flex justify-between py-1.5 border-b border-stone-100">
            <span class="text-stone-600">Bailong Elevator</span>
            <span class="font-semibold text-stone-800">CNY 72</span>
          </div>
          <div class="flex justify-between py-1.5 border-b border-stone-100">
            <span class="text-stone-600">Tianzi Mountain cable car</span>
            <span class="font-semibold text-stone-800">CNY 72</span>
          </div>
          <div class="flex justify-between py-1.5 border-b border-stone-100">
            <span class="text-stone-600">Tianmen Mountain</span>
            <span class="font-semibold text-stone-800">CNY 261</span>
          </div>
          <div class="flex justify-between py-1.5 border-b border-stone-100">
            <span class="text-stone-600">Grand Canyon + Glass Bridge</span>
            <span class="font-semibold text-stone-800">CNY 248</span>
          </div>
          <div class="flex justify-between py-1.5">
            <span class="text-stone-500 text-xs">Per person, full visit estimate</span>
            <span class="font-semibold text-forest-700">CNY 500-800</span>
          </div>
        </div>
        <p class="text-xs text-stone-400 mt-3">Prices verified at Wulingyuan gate, April 2026. Student/senior discounts available.</p>
        <a href="/tickets/" class="inline-flex items-center gap-1 mt-3 text-xs font-medium text-amber-600 hover:text-amber-700">
          Full ticket breakdown →
        </a>
      </div>

      <!-- Park Zones Overview -->
      <div class="rounded-2xl border border-stone-200 bg-white p-6">
        <div class="flex items-center gap-2 mb-4">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-forest-50">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-forest-600"><path d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/></svg>
          </div>
          <h3 class="font-semibold text-stone-800">Park Zones at a Glance</h3>
        </div>
        <div class="space-y-3 text-sm">
          <div>
            <span class="inline-block rounded-full bg-forest-50 px-2 py-0.5 text-xs font-medium text-forest-700 mb-1">Must see</span>
            <p class="text-stone-600"><strong class="text-stone-700">Yuanjiajie</strong> — <a href="/avatar-mountains/" class="text-forest-600 hover:text-forest-700 underline">Avatar Hallelujah Mountain</a>, Bailong Elevator. This is the one you have seen in photos. <span class="text-stone-400">Allow half a day.</span></p>
          </div>
          <div>
            <span class="inline-block rounded-full bg-forest-50 px-2 py-0.5 text-xs font-medium text-forest-700 mb-1">Must see</span>
            <p class="text-stone-600"><strong class="text-stone-700">Tianzi Mountain</strong> — Sea of clouds at sunrise, Imperial Writing Brush Peaks. <span class="text-stone-400">Best before 9 AM.</span></p>
          </div>
          <div>
            <span class="inline-block rounded-full bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-700 mb-1">If time allows</span>
            <p class="text-stone-600"><strong class="text-stone-700">Yangjiajie</strong> — Less crowded, fortress-like pillars, "One Step to Heaven" viewpoint. Tougher hiking but worth it.</p>
          </div>
          <div>
            <span class="inline-block rounded-full bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-700 mb-1">If time allows</span>
            <p class="text-stone-600"><strong class="text-stone-700">Golden Whip Stream</strong> — Flat 7.5 km trail through the canyon floor. Monkeys everywhere. <span class="text-stone-400">Good for all fitness levels.</span></p>
          </div>
        </div>
        <a href="/guide/" class="inline-flex items-center gap-1 mt-4 text-xs font-medium text-forest-600 hover:text-forest-700">
          Full zone guide & map →
        </a>
      </div>
    </div>
  </section>

  <!-- Interactive Park Map -->
  <section class="mx-auto max-w-7xl px-4 md:px-6 pb-20 md:pb-28 reveal">
    <div class="text-center mb-8">
      <SectionHeader eyebrow="Park Map" title="Navigate the Park Zones" subtitle="Schematic overview of the five main scenic areas, shuttle routes, and entrance gates. Click any zone to explore." center />
    </div>
    <ParkMap />
  </section>

  <!-- Where to Stay -->
  <section class="mx-auto max-w-7xl px-4 md:px-6 pb-20 md:pb-28 reveal">
    <div class="text-center mb-10">
      <SectionHeader eyebrow="Where to Stay" title="Pick Your Base" subtitle="We have stayed in all three areas across 20+ visits. Here is the honest comparison." center />
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      {[
        {
          area: "Wulingyuan Town",
          verdict: "Best overall · Our pick",
          price: "CNY 150 – 800 / night",
          vibe: "5-15 min walk to park gate. Hundreds of hotels, restaurants, street food, convenience stores. Lively in the evening with restaurants and foot massage parlors for post-hike recovery.",
          picks: [
            { name: "Pullman Zhangjiajie", tier: "Luxury", note: "5-star, pool, 10 min walk to gate" },
            { name: "Lee's Boutique Resort", tier: "Mid-range", note: "Mountain views, quiet, great breakfast" },
            { name: "Edinburgh Hostel", tier: "Budget", note: "Backpacker favorite, dorm from CNY 60" }
          ],
          border: "border-forest-300 bg-forest-50/30"
        },
        {
          area: "Zhangjiajie City Center",
          verdict: "Cheaper but commute adds up",
          price: "CNY 80 – 500 / night",
          vibe: "40 min bus to Wulingyuan gate each way. Cheaper hotels, more international food options, closer to the airport and train station. Good if you are also visiting Tianmen Mountain (cable car station is downtown).",
          picks: [
            { name: "Huatian Hotel", tier: "Luxury", note: "Near Tianmen cable car, 5-star" },
            { name: "Sunshine Hotel", tier: "Mid-range", note: "Good value, central location" },
            { name: "Zhangjiajie Cloud Inn", tier: "Budget", note: "Clean, basic, CNY 100-150" }
          ],
          border: "border-stone-200 bg-white"
        },
        {
          area: "Inside the Park",
          verdict: "Wake up in the mist · Spartan",
          price: "CNY 200 – 400 / night",
          vibe: "A handful of basic guesthouses operate inside the park near Golden Whip Stream and the Tianzi Mountain area. No hot water sometimes, limited food options, but you wake up to mist-filled valleys with zero tourists. Best for photographers chasing sunrise.",
          picks: [
            { name: "Tujia Cottage", tier: "Rustic", note: "Local family-run, home-cooked meals" },
            { name: "Forest Edge Guesthouse", tier: "Rustic", note: "Golden Whip Stream area" }
          ],
          border: "border-amber-200 bg-amber-50/30"
        }
      ].map(({ area, verdict, price, vibe, picks, border }) => (
        <div class={`rounded-2xl border ${border} p-6`}>
          <h3 class="text-lg font-semibold text-stone-800">{area}</h3>
          <p class="text-xs font-medium text-forest-600 mt-0.5">{verdict}</p>
          <p class="text-sm text-stone-400 mt-1">{price}</p>
          <p class="mt-3 text-sm text-stone-500 leading-relaxed">{vibe}</p>
          <div class="mt-4 pt-3 border-t border-stone-100">
            <p class="text-xs font-medium text-stone-400 uppercase tracking-wider mb-2">Our picks</p>
            {picks.map(({ name, tier, note }) => (
              <div class="flex gap-2 text-sm mb-1.5">
                <span class="inline-flex items-center rounded-full bg-white border border-stone-200 px-2 py-0 text-xs text-stone-500 shrink-0">{tier}</span>
                <span class="text-stone-700 font-medium">{name}</span>
                <span class="text-stone-400 text-xs hidden sm:inline">— {note}</span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
    <div class="text-center mt-8">
      <a href="/hotels/" class="inline-flex items-center gap-1 text-sm font-medium text-forest-600 hover:text-forest-700 transition-colors">
        Full accommodation guide with 20+ hotels →
      </a>
    </div>
  </section>

  <!-- Plan Your Trip in 30 Seconds -->
  <section class="mx-auto max-w-7xl px-4 md:px-6 py-20 md:py-28">
    <TripPlanner />
  </section>

  <!-- When to Go: Season Quick Picker -->
  <section id="when-to-go" class="bg-stone-100 border-y border-stone-200 reveal">
    <div class="mx-auto max-w-7xl px-4 md:px-6 py-20 md:py-28">
    <div class="text-center mb-12">
      <SectionHeader eyebrow="When to Go" title="Pick Your Season" subtitle="Every season paints the pillars differently. Here is what we found after visiting in all four — pick the one that matches what you want to see." center />
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {[
        {
          season: "Spring",
          months: "Mar – May",
          temp: "8 – 28°C",
          crowd: "Low → Moderate",
          icon: "🌿",
          badge: "Best overall",
          badgeColor: "bg-forest-100 text-forest-700",

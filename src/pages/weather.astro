const schema = {"@context":"https://schema.org","@graph":[{"@type":"Article","headline":"Zhangjiajie Weather | Monthly Forecast & Climate Guide (2026)","description":"Zhangjiajie weather by month: temperature, rainfall, what to wear, and how weather affects park access. Based on first-hand visits across all seasons.","datePublished":"2026-07-01","dateModified":"2026-07-31","author":{"@type":"Person","name":"Zhangjiajie Guide Team"}},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://zhangjiajie-national-park.com/"},{"@type":"ListItem","position":2,"name":"Weather","item":"https://zhangjiajie-national-park.com/weather/"}]}]};
const months = [
  {m:"Jan",hi:"8",lo:"1",rain:"40",wear:"Heavy jacket, thermals, gloves, waterproof boots. Snow possible on upper trails."},
  {m:"Feb",hi:"10",lo:"3",rain:"55",wear:"Warm jacket, layers. Lighter than January but still cold. Chinese New Year crowds in town, not park."},
  {m:"Mar",hi:"15",lo:"7",rain:"90",wear:"Light jacket + rain shell. Temperatures swing 10-15C between morning and afternoon."},
  {m:"Apr",hi:"22",lo:"12",rain:"140",wear:"T-shirt + light jacket. Best month overall. Rain jacket essential for afternoon showers."},
  {m:"May",hi:"27",lo:"17",rain:"180",wear:"Short sleeves, sun hat, rain shell. Hot by midday. Avoid May 1-5 (Labor Day)."},
  {m:"Jun",hi:"30",lo:"21",rain:"210",wear:"Lightest clothing, rain jacket. Humid. Afternoon thunderstorms most days, pass quickly."},
  {m:"Jul",hi:"33",lo:"24",rain:"190",wear:"Shorts, t-shirt, rain gear. Peak heat and humidity. Start hikes by 7 AM."},
  {m:"Aug",hi:"32",lo:"23",rain:"170",wear:"Same as July. Afternoon storms. Park at its greenest."},
  {m:"Sep",hi:"28",lo:"19",rain:"100",wear:"Light layers. Early September still warm. Late September is ideal — less rain, fewer crowds."},
  {m:"Oct",hi:"22",lo:"14",rain:"85",wear:"Light jacket for mornings. AVOID Oct 1-7 Golden Week. Late October is perfect."},
  {m:"Nov",hi:"15",lo:"8",rain:"55",wear:"Warm jacket, scarf. Our favorite month. Autumn colors, crisp air, near-empty trails."},
  {m:"Dec",hi:"10",lo:"3",rain:"30",wear:"Heavy jacket, thermals. Snow-dusted pillars. Half-price tickets. Some trails closed after snow."}
